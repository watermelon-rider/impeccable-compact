#!/bin/sh
# Bootstrap launcher for an Impeccable prompt package.
# The executable engine is shared across every skill through one user cache.
set -eu

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
skill_dir=$(CDPATH= cd -- "$dir/.." && pwd)
: "${IMPECCABLE_SKILL_DIR:=$skill_dir}"
: "${IMPECCABLE_SELF:=$0}"
export IMPECCABLE_SKILL_DIR IMPECCABLE_SELF

if [ -n "${IMPECCABLE_BIN:-}" ] && [ -x "${IMPECCABLE_BIN}" ]; then
  exec "${IMPECCABLE_BIN}" "$@"
fi

version=""
if [ -f "$dir/VERSION" ]; then
  version=$(tr -d '[:space:]' < "$dir/VERSION")
fi
cache_root="${IMPECCABLE_HOME:-${HOME:-/nonexistent}/.impeccable}"
cached="$cache_root/runtime/$version/impeccable"

if [ -n "$version" ] && [ -x "$cached" ]; then
  exec "$cached" "$@"
fi

echo "compact: shared runtime $version is not installed." >&2
echo "Install it once through the compact runtime installer, or set IMPECCABLE_BIN." >&2
exit 127

